  font-family: Arial, sans-serif;
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
  margin: 0;
  background-color: #f0f0f0;
}

.calculator {
  width: 300px;
  padding: 20px;
  border-radius: 8px;
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
  background-color: #fff;
}

.display {
  width: 100%;
  height: 50px;
  margin-bottom: 20px;
  text-align: right;
  padding-right: 10px;
  font-size: 24px;
  border: none;
  background-color: #e0e0e0;
}

.button {
  width: calc(33.3% - 8px);
  height: 50px;
  margin: 4px;
  border: none;
  border-radius: 6px;
  font-size: 20px;
  cursor: pointer;
  background-color: #ddd;
}

.button:hover {
  background-color: #ccc;
}
